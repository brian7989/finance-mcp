{
  "name": "finance-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal read-only finance MCP with history on Cloudflare Workers",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "format": "biome format --write .",
    "lint": "biome check . && eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1118.0",
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/server": "2.3.1",
    "axios": "1.20.0",
    "big.js": "7.0.1",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.12",
    "openid-client": "6.8.8",
    "plaid": "48.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261011.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/big.js": "7.0.0",
    "@types/node": "24.13.3",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
