{
  "name": "finance-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal read-only finance MCP with history on Cloudflare Workers",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm build:client && wrangler dev",
    "deploy": "pnpm build:client && wrangler deploy",
    "build": "pnpm build:client && wrangler deploy --dry-run --outdir dist/worker",
    "format": "biome format --write .",
    "lint": "biome check . && eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json",
    "test": "pnpm build:client && vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "build:client": "vite build"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1118.0",
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/server": "2.3.1",
    "axios": "1.20.0",
    "big.js": "7.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "lucide-react": "1.55.0",
    "openid-client": "6.8.8",
    "plaid": "48.0.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261011.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/big.js": "7.0.0",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
