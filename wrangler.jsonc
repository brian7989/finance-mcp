{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finance-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "eba28958df4d4ac2b5063ec76eeff772"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BENEPASS_SESSION",
        "class_name": "BenepassSession"
      },
      {
        "name": "FINANCE_STORE",
        "class_name": "FinanceStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BenepassSession",
        "FinanceStore"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "0 7,8 * * *"
    ]
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.sql"
      ],
      "fallthrough": true
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
